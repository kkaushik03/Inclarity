# Copy to .env and adjust as needed. Do not commit .env.
# Platforms like Render/Railway set these in the dashboard instead.

# Server (used by `python -m backend.api.app`; gunicorn uses $PORT from the host)
PORT=5000

# Semantic matching — heavy (PyTorch). Defaults to false on Render/Railway.
# Locally defaults to true. Set explicitly if you want to override.
# ENABLE_SEMANTIC=false
SEMANTIC_MODEL_NAME=all-MiniLM-L6-v2

# Ensemble weights (should sum to 1.0)
FUZZY_WEIGHT=0.45
SEMANTIC_WEIGHT=0.55

# Confidence routing
AUTO_ACCEPT_THRESHOLD=0.90
REVIEW_THRESHOLD=0.60
TOP_K=3
